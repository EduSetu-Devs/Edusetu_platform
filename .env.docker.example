# Copy this file to .env.docker (never commit it) and replace every value.
# Generate secrets with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"

# Public HTTPS origin of the deployed site (no trailing slash).
CLIENT_URL=https://app.example.com
CORS_ORIGIN=https://app.example.com

# Database
MYSQL_ROOT_PASSWORD=REPLACE_WITH_48_RANDOM_CHARS
DB_NAME=edusetu
DB_USER=edusetu_user
DB_PASSWORD=REPLACE_WITH_48_RANDOM_CHARS
DB_SYNC=false
SEED_INDIAN_TUTORS=false
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARS
JWT_EXPIRES_IN=7d
OTP_HASH_SECRET=REPLACE_WITH_A_DIFFERENT_32_PLUS_RANDOM_VALUE
ADMIN_VERIFICATION_PASSWORD=REPLACE_WITH_A_12_PLUS_CHAR_UNIQUE_PASSPHRASE
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_SECURE=true
AUTH_EXPOSE_TOKEN=false
ALLOW_UNVERIFIED_REGISTRATION=false

# AI provider (leave blank to disable AI features cleanly)
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
AI_API_URL=
AI_MAX_TOKENS=800
AI_TIMEOUT_MS=20000
AI_DAILY_USER_LIMIT=40
AI_DAILY_GLOBAL_LIMIT=2000

# Optional Redis (rate limits, caching, sessions). Leave blank for in-memory fallback.
REDIS_URL=

# Optional metrics endpoint protection
METRICS_TOKEN=

# Transactional email (OTP verification)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=EduSetu <no-reply@example.com>
