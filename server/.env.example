# Server Configuration
PORT=5000
NODE_ENV=development

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# Database Configuration (MySQL / Sequelize)
DB_NAME=edusetu
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DIALECT=mysql

# Authentication
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Administrator Security (Required for Admin Portal Verification)
ADMIN_VERIFICATION_PASSWORD=change_this_to_a_secure_value

# AI provider. The Study Assistant supports the OpenAI Chat Completions API.
# Keep credentials server-side; never use VITE_ variables here.
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_API_URL=https://api.openai.com/v1/chat/completions

# WebRTC ICE configuration is supplied to the browser through the client build.
# Use a public STUN server for development. Production TURN credentials must be
# short-lived and generated by a protected service; do not commit static secrets.
