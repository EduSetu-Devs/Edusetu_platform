# Server Configuration
PORT=5000
NODE_ENV=development

# Public SPA origin(s), comma-separated for multiple domains
CLIENT_URL=http://localhost:5173
# CORS_ORIGIN=https://app.example.com

# Database Configuration (MySQL / Sequelize)
# Default root without a password works for XAMPP / WAMP / local MySQL only.
DB_NAME=edusetu
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DIALECT=mysql

# Authentication
# DEVELOPMENT ONLY: replace with a random 32+ character value before any deployment.
JWT_SECRET=edusetu_dev_jwt_secret_key_2026
JWT_EXPIRES_IN=7d
# Separate HMAC key for hashing email OTPs. Defaults to JWT_SECRET in development.
OTP_HASH_SECRET=

# Administrator Portal (required in production; minimum 12 characters)
ADMIN_VERIFICATION_PASSWORD=

# Browser session cookies
# Use SameSite=None + Secure only when the SPA and API are on different sites.
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_SECURE=false
# Expose JWTs in JSON responses only for trusted non-browser API clients.
AUTH_EXPOSE_TOKEN=false
# Production always requires OTP email verification; do not enable there.
ALLOW_UNVERIFIED_REGISTRATION=false

# Demo data (must remain false in production)
SEED_INDIAN_TUTORS=false

# AI Study Assistant Provider Configuration
# Leave AI_API_KEY empty to keep AI features disabled.
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_MAX_TOKENS=800
AI_TIMEOUT_MS=20000
AI_DAILY_USER_LIMIT=40
AI_DAILY_GLOBAL_LIMIT=2000

# Transactional email for OTP verification
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=EduSetu <no-reply@edusetu.in>

# WebRTC ICE configuration for online classroom
VITE_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"}]
