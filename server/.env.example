# Server Configuration
PORT=5000
NODE_ENV=development

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# Database Configuration (MySQL / Sequelize)
# Default root without password works for XAMPP / WAMP / standard local MySQL.
# If your MySQL has a password, set it here.
DB_NAME=edusetu
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DIALECT=mysql

# Authentication Secret (Development Default)
JWT_SECRET=edusetu_dev_jwt_secret_key_2026
JWT_EXPIRES_IN=7d

# Administrator Security (Required for Admin Portal Verification)
ADMIN_VERIFICATION_PASSWORD=admin123

# AI Study Assistant Provider Configuration
# Set your Gemini or OpenAI API Key below to enable live AI generations:
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_API_URL=https://api.openai.com/v1/chat/completions

# WebRTC ICE configuration for online classroom
VITE_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"}]
